meta {
  name: purchase ticket
  type: http
  seq: 2
}

post {
  url: {{api_url}}/tickets/purchase
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearer_token}}
}

body:json {
  {
    "sessionId": 77,
    "tickets": [
      {
        "skateId": 1,
        "pricingId": 1
      },
      {
        "skateId": 2,
        "pricingId": 2
      }
    ]
  }
}
