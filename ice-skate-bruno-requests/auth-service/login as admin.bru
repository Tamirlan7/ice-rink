meta {
  name: login as admin
  type: http
  seq: 2
}

post {
  url: {{api_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phoneNumber": "+77007007070",
    "password": "1234"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("bearer_token", res.body.accessToken)
  }
  
}
